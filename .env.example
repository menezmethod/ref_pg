# Required. Use long random values.
POSTGRES_PASSWORD=change-me
# Goes into a connection URI: use letters and digits only (e.g. openssl rand -hex 24).
AUTHENTICATOR_PASSWORD=change-me-too

# Optional
POSTGRES_USER=postgres
POSTGRES_DB=url_shortener
PORT=8001
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
# Reverse proxies in front of OpenResty (CIDRs, space or comma separated).
# Set this behind Coolify/Traefik so rate limits and click stats see real client IPs.
TRUSTED_PROXIES=
LINK_CACHE_SECONDS=60
LINK_NEGATIVE_CACHE_SECONDS=10
CLICK_FLUSH_SECONDS=1
# Clicks OpenResty may hold (all workers together) while Postgres is slow or down.
# Size it as click rate x the longest stall to ride out: 20,000/s x 10 s = 200,000.
CLICK_BUFFER=200000
# Days of raw clicks to keep (whole UTC days are dropped hourly; 0 keeps everything).
# Link stats come from rollups and are not affected.
CLICK_RETENTION_DAYS=90
# Lookups allowed to wait on Postgres at once (all workers together); past that,
# cold misses get 503. Worst-case wait = this / lookups per second the node handles.
LOOKUP_CONCURRENCY=10
LINK_CACHE_MB=32
LINK_MISS_CACHE_MB=8
WORKER_PROCESSES=auto
LOG_LEVEL=notice
ACCESS_LOG=/dev/stdout
CORS_ALLOW_ORIGIN=*
